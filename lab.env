# Settings for the Kafka DR lab apps. Edit, then run: ./run.sh restart

# Kafka addresses (the same names or IPs you used in mm2.properties)
export PRIMARY_BOOTSTRAP="kafka:9092"
export BACKUP_BOOTSTRAP="kafka-backup:9092"

# Must match the first name in "clusters = primary, backup" in mm2.properties.
export PRIMARY_ALIAS="primary"

# Must match replication.policy.class in mm2.properties:
#   identity = same topic names on both clusters (IdentityReplicationPolicy): orders -> orders
#   default  = MirrorMaker adds the alias (DefaultReplicationPolicy):        orders -> primary.orders
export REPLICATION_POLICY="identity"

# Failover: check every CHECK_INTERVAL_SEC seconds (each check waits up to
# CHECK_TIMEOUT_SEC), and fail over after FAIL_THRESHOLD failed checks in a row.
export CHECK_INTERVAL_SEC=2
export CHECK_TIMEOUT_SEC=3
export FAIL_THRESHOLD=3

# Replication factor for topics created by the producer app (1 for the lab)
export TOPIC_REPLICATION_FACTOR=1

# Consumer: a gap only counts as "missing" after this many seconds
export MISSING_GRACE_SEC=5

# Web UIs. 0.0.0.0 = open them through the VM's private IP (over VPN),
# for example http://10.110.10.8:8080. Needs a firewall rule, see README.
export UI_HOST="0.0.0.0"
export PRODUCER_PORT=8080
export CONSUMER_PORT=8081

# Optional login for the web UIs. Empty password = no login, which is fine
# while the VM has only a private IP. Set one if the VM gets a public IP.
export UI_USER="lab"
export UI_PASSWORD=""

# Kafka installation (used by slow-link.sh)
export KAFKA_HOME="$HOME/kafka"
